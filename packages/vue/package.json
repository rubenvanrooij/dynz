{
  "name": "@dynz/vue",
  "version": "0.1.0",
  "private": false,
  "license": "BUSL-1.1",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "typescript",
    "schema",
    "validation",
    "parsing",
    "form",
    "type-safe",
    "vue",
    "vee-validate"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rubenvanrooij/dynz"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Ruben van Rooij <ruben.van.rooij@gmail.com>",
  "description": "Vue 3 integration for dynz.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "peerDependencies": {
    "dynz": "^1.1.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.0.0",
    "tsdown": "^0.16.5",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41"
  }
}
