{
  "name": "@dynz/react-hook-form",
  "version": "1.2.0",
  "private": false,
  "license": "BUSL-1.1",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "typescriptn",
    "schema",
    "validation",
    "parsing",
    "form",
    "type-safe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rubenvanrooij/dynz"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Ruben van Rooij <ruben.van.rooij@gmail.com>",
  "description": "React hook form integration for dynz.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "dependencies": {
    "dynz": "workspace:*"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.2",
    "happy-dom": "^20.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.75.0",
    "tsdown": "^0.16.5"
  }
}